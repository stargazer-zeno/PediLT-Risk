# ---- Bundled XGBoost artifacts ----
# Override only when testing a different validated delivery.
# SCHEMA_PATH=./artifacts/datasets/schema.json
# MODEL_DIR=./artifacts/xgboost

# ---- Self-hosted vLLM API (OpenAI-compatible) ----
# Leave blank for ML-only mode, or set an OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=zeno156/PediLT-Risk-Qwen3-4B
# sft_pattern_prob returns Pattern/Analysis/Answer for the deployed SFT model.
LLM_PROMPT_MODE=sft_pattern_prob
LLM_TIMEOUT_SECONDS=900
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
# For Qwen/vLLM chat templates that support it.
LLM_ENABLE_THINKING=false
LLM_PATTERN_GUARD_ENABLED=true
LLM_RATIONALE_SECOND_PASS=true
LLM_RATIONALE_MAX_TOKENS=768

# ---- Backend ----
JOBS_DIR=./data/jobs
MAX_UPLOAD_MB=50
JOB_WORKERS=2
CORS_ORIGINS=*

# ---- Host ports ----
BACKEND_PORT=8000
FRONTEND_PORT=8080
